# TraceFix — env example
PORT=4100
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100
SESSION_SECRET=change-me-to-a-long-random-string

# MongoDB (users, debug session history, analytics)
# Include a database name in the path, e.g. .../tracefix?...
MONGODB_URI=mongodb://127.0.0.1:27017/tracefix

# mock | openai | huggingface
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V3.2

SANDBOX_DIR=.tracefix-sandboxes
# Keep only the newest N sandbox copies (0 = unlimited). Prevents disk growth across many runs.
SANDBOX_MAX_COUNT=20
# If true, delete this run's sandbox when the session finishes (history stays in MongoDB).
SANDBOX_CLEANUP_ON_COMPLETE=false
MAX_FIX_ATTEMPTS=2
BROWSER_NAV_TIMEOUT_MS=15000
APP_READY_TIMEOUT_MS=60000

# GitHub OAuth (reuse DevMate app credentials; add this callback URL in the OAuth App settings)
# http://localhost:4100/auth/github/callback
API_URL=http://localhost:4100
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo read:user user:email

# Optional: push fix branch when remote exists (local mode)
# GITHUB_TOKEN=
